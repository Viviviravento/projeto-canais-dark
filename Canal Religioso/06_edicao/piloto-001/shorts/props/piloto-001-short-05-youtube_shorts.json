  "cues": [
    {
      "start": 0.12,
      "end": 3.672,
      "text": "Maturidade não é se tornar uma pessoa que nunca"
    },
    {
      "start": 3.696,
      "end": 7.284,
      "text": "precisa de ninguém. Fé não é se fechar e"
    },
    {
      "start": 7.318,
      "end": 9.826,
      "text": "dizer que está tudo bem quando não está."
    },
    {
      "start": 10.534,
      "end": 13.681,
      "text": "Há cargas que precisam ser divididas."
    },
    {
      "start": 14.342,
      "end": 16.885,
      "text": "Uma conversa honesta com alguém de confiança."
    },
    {
      "start": 17.373,
      "end": 18.685,
      "text": "Um pedido de perdão."
    },
    {
      "start": 18.952,
      "end": 20.948,
      "text": "Um limite colocado com respeito."
    },
    {
      "start": 21.517,
      "end": 24.942,
      "text": "Uma ajuda aceita. Uma porta aberta quando você já"
    },
    {
      "start": 25.0,
      "end": 29.389,
      "text": "percebeu que, sozinha, não está conseguindo atravessar aquele momento."
    },
    {
      "start": 30.329,
      "end": 33.72,
      "text": "Nem toda pessoa saberá carregar uma parte do seu peso."
    },
    {
      "start": 34.486,
      "end": 35.113,
      "text": "Por isso,"
    },
    {
      "start": 35.879,
      "end": 38.166,
      "text": "sabedoria também é escolher"
    },
    {
      "start": 39.06,
      "end": 40.593,
      "text": "com quem dividir."
    },
    {
      "start": 41.254,
      "end": 43.995,
      "text": "Mas guardar tudo por medo de incomodar os outros"
    },
    {
      "start": 44.355,
      "end": 46.061,
      "text": "não é o único caminho possível."
    },
    {
      "start": 46.363,
      "end": 48.975,
      "text": "Pedir ajuda não diminui a sua fé."
    },
    {
      "start": 49.324,
      "end": 53.167,
      "text": "Em muitos momentos, é justamente uma forma de reconhecer"
    },
    {
      "start": 53.213,
      "end": 56.777,
      "text": "que Deus também cuida de nós por meio de"
    },
    {
      "start": 56.835,
      "end": 60.969,
      "text": "pessoas, de conversas sinceras e de apoio concreto."
    }
  ],
  "platform": "youtube_shorts"
}
