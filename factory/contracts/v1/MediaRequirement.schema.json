{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.canais-dark/contracts/v1/MediaRequirement.schema.json",
  "title": "MediaRequirement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "requirement_id", "communicative_function", "minimum_fidelity", "authenticity", "rights", "target_formats", "cost_options", "acceptance_criteria"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "requirement_id": {"type": "string", "minLength": 1},
    "communicative_function": {"type": "string", "minLength": 1},
    "minimum_fidelity": {"enum": ["symbolic", "recognizable", "specific", "documentary"]},
    "authenticity": {"type": "object", "required": ["constraints"], "properties": {"constraints": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "rights": {"type": "object", "additionalProperties": false, "required": ["allowed_licenses", "attribution_required"], "properties": {"allowed_licenses": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "attribution_required": {"type": "boolean"}}},
    "target_formats": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "cost_options": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": true, "required": ["method", "estimated_cost", "eligible"], "properties": {"method": {"type": "string"}, "estimated_cost": {"type": "number", "minimum": 0}, "eligible": {"type": "boolean"}}}},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  }
}
