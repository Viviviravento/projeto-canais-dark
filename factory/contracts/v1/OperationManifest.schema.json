{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.canais-dark/contracts/v1/OperationManifest.schema.json",
  "title": "OperationManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "display_name",
    "lifecycle",
    "purpose",
    "surfaces",
    "formats",
    "capabilities",
    "parameters",
    "policies"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "operation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
    "display_name": {"type": "string", "minLength": 1},
    "lifecycle": {
      "enum": ["exploring", "incubating", "piloting", "stabilizing", "operational", "paused", "retired"]
    },
    "purpose": {"type": "string", "minLength": 1},
    "surfaces": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "formats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "baseline", "evidence_refs", "notes"],
        "properties": {
          "state": {
            "enum": [
              "not_exercised",
              "investigating",
              "exercised",
              "validating",
              "stable",
              "regression_detected",
              "blocked",
              "not_applicable"
            ]
          },
          "baseline": {"type": ["string", "null"]},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "notes": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"state": {"const": "stable"}}, "required": ["state"]},
            "then": {"properties": {"baseline": {"type": "string", "minLength": 1}}}
          },
          {
            "if": {
              "properties": {
                "state": {
                  "enum": ["not_exercised", "investigating", "exercised", "validating", "blocked", "not_applicable"]
                }
              },
              "required": ["state"]
            },
            "then": {"properties": {"baseline": {"const": null}}}
          }
        ]
      }
    },
    "audience": {"type": "object", "additionalProperties": true},
    "promise": {"type": "string"},
    "positioning": {"type": "string"},
    "economics": {"type": "object", "additionalProperties": true},
    "parameters": {"type": "object"},
    "policies": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"lifecycle": {"enum": ["piloting", "stabilizing", "operational"]}},
        "required": ["lifecycle"]
      },
      "then": {
        "properties": {
          "surfaces": {"minItems": 1},
          "formats": {"minItems": 1}
        }
      }
    }
  ]
}
