{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.canais-dark/contracts/v1/OperationManifest.schema.json",
  "title": "OperationManifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "operation_id", "display_name", "lifecycle", "surfaces", "formats", "capabilities"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "operation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
    "display_name": {"type": "string", "minLength": 1},
    "lifecycle": {"enum": ["exploring", "incubating", "piloting", "stabilizing", "operational", "paused", "retired"]},
    "surfaces": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "formats": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true, "required": ["id", "description"], "properties": {"id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}},
      "minItems": 1
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["state", "baseline", "evidence_refs"],
        "properties": {
          "state": {"enum": ["unexercised", "investigating", "validating", "stable", "regression_detected", "blocked", "not_applicable"]},
          "baseline": {"type": ["string", "null"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {"if": {"properties": {"state": {"const": "stable"}}}, "then": {"properties": {"baseline": {"type": "string", "minLength": 1}}, "required": ["baseline"]}},
          {"if": {"properties": {"state": {"enum": ["blocked", "not_applicable"]}}}, "then": {"required": ["reason"]}}
        ]
      }
    }
  }
}
