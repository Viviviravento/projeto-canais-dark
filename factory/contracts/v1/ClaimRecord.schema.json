{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.canais-dark/contracts/v1/ClaimRecord.schema.json",
  "title": "ClaimRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_id", "statement", "classification", "recorded_at", "scope", "confidence", "decision_refs"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "claim_id": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "classification": {"enum": ["user_input", "hypothesis", "research", "observation", "decision"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator", "accessed_at"],
      "properties": {
        "kind": {"enum": ["user", "primary", "secondary", "local_artifact", "platform_observation"]},
        "locator": {"type": "string", "minLength": 1},
        "publisher": {"type": "string"},
        "published_at": {"type": ["string", "null"]},
        "accessed_at": {"type": "string", "format": "date-time"}
      }
    },
    "recorded_at": {"type": "string", "format": "date-time"},
    "scope": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "decision_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "allOf": [
    {
      "if": {"properties": {"classification": {"enum": ["research", "observation"]}}, "required": ["classification"]},
      "then": {"required": ["source"]}
    }
  ]
}
