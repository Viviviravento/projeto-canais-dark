{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.canais-dark/contracts/v1/CleanRun.schema.json",
  "title": "CleanRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "operation_id",
    "recorded_at",
    "clean",
    "disqualifiers",
    "evidence_artifacts",
    "canonical_state_matches_execution"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "clean": {"type": "boolean"},
    "disqualifiers": {
      "type": "array",
      "items": {
        "enum": [
          "known_regression_accepted",
          "user_recalled_existing_rule",
          "avoidable_paid_retry",
          "gate_bypassed",
          "baseline_diverged_without_revalidation",
          "evidence_missing",
          "fundamental_defect_detected_only_in_final",
          "canonical_state_mismatch"
        ]
      },
      "uniqueItems": true
    },
    "evidence_artifacts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "canonical_state_matches_execution": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"clean": {"const": true}}, "required": ["clean"]},
      "then": {
        "properties": {
          "disqualifiers": {"maxItems": 0},
          "evidence_artifacts": {"minItems": 1},
          "canonical_state_matches_execution": {"const": true}
        }
      },
      "else": {"properties": {"disqualifiers": {"minItems": 1}}}
    }
  ]
}
