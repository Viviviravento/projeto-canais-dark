  "cues": [
    {
      "start": 0.12,
      "end": 2.639,
      "text": "Aqui precisamos fazer uma distinção importante."
    },
    {
      "start": 3.104,
      "end": 7.179,
      "text": "Hoje, a palavra ansiedade também descreve condições de saúde"
    },
    {
      "start": 7.214,
      "end": 11.347,
      "text": "que podem envolver medo intenso, sintomas físicos,"
    },
    {
      "start": 11.742,
      "end": 14.737,
      "text": "sofrimento prolongado e prejuízo na vida familiar,"
    },
    {
      "start": 15.027,
      "end": 19.241,
      "text": "social ou profissional. Não é honesto pegar uma palavra"
    },
    {
      "start": 19.3,
      "end": 20.635,
      "text": "de um texto antigo,"
    },
    {
      "start": 21.447,
      "end": 25.209,
      "text": "ignorar todo o contexto e concluir que quem enfrenta"
    },
    {
      "start": 25.244,
      "end": 30.259,
      "text": "um transtorno de ansiedade está simplesmente desobedecendo a Jesus."
    },
    {
      "start": 30.799,
      "end": 32.645,
      "text": "Fé e tratamento não são rivais."
    },
    {
      "start": 32.9,
      "end": 37.556,
      "text": "Procurar ajuda profissional, fazer psicoterapia ou seguir uma"
    },
    {
      "start": 37.614,
      "end": 41.19,
      "text": "orientação médica não significa que a pessoa deixou de"
    },
    {
      "start": 41.236,
      "end": 45.66,
      "text": "confiar em Deus. Pode ser justamente uma forma responsável"
    },
    {
      "start": 46.31,
      "end": 47.355,
      "text": "de cuidar da vida."
    },
    {
      "start": 48.121,
      "end": 51.975,
      "text": "As palavras de Jesus não precisam ser usadas para"
    },
    {
      "start": 52.08,
      "end": 56.259,
      "text": "envergonhar quem sofre. Elas podem ser recebidas como um"
    },
    {
      "start": 56.317,
      "end": 60.23,
      "text": "convite para que a preocupação não tenha a palavra"
    },
    {
      "start": 60.288,
      "end": 64.793,
      "text": "final sobre quem somos, sobre o valor da"
    },
    {
      "start": 64.851,
      "end": 69.065,
      "text": "nossa vida e sobre onde colocamos nossa esperança."
    }
  ],
