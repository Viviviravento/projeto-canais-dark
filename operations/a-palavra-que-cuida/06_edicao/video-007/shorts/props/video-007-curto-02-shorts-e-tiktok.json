  "cues": [
    {
      "start": 0.08,
      "end": 3.465,
      "text": "Quando você perceber que uma escolha está parecendo urgente"
    },
    {
      "start": 3.508,
      "end": 6.731,
      "text": "demais, tente não decidir apenas no impulso."
    },
    {
      "start": 7.36,
      "end": 9.693,
      "text": "Não para se tornar lenta em tudo."
    },
    {
      "start": 10.095,
      "end": 12.569,
      "text": "Mas para não entregar o volante da vida ao"
    },
    {
      "start": 12.612,
      "end": 14.337,
      "text": "momento mais fraco do dia."
    },
    {
      "start": 14.967,
      "end": 15.975,
      "text": "Primeira pergunta:"
    },
    {
      "start": 16.604,
      "end": 20.153,
      "text": "que necessidade verdadeira está gritando em mim agora?"
    },
    {
      "start": 20.413,
      "end": 23.159,
      "text": "Talvez seja descanso. Talvez seja proteção."
    },
    {
      "start": 23.571,
      "end": 26.468,
      "text": "Talvez seja carinho. Talvez seja reconhecimento."
    },
    {
      "start": 26.945,
      "end": 29.549,
      "text": "Dar nome à necessidade não é fraqueza."
    },
    {
      "start": 29.961,
      "end": 33.433,
      "text": "É parar de deixar que ela trabalhe escondida."
    },
    {
      "start": 34.085,
      "end": 37.058,
      "text": "Segunda pergunta: este caminho cuida de mim ou só"
    },
    {
      "start": 37.112,
      "end": 39.097,
      "text": "silencia a dor por alguns minutos?"
    },
    {
      "start": 39.704,
      "end": 44.164,
      "text": "Existem alívios que parecem descanso, mas roubam paz depois."
    },
    {
      "start": 44.772,
      "end": 48.744,
      "text": "Existem escolhas que parecem liberdade, mas aumentam a prisão."
    },
    {
      "start": 49.351,
      "end": 52.682,
      "text": "Existem promessas que parecem afeto, mas deixam a pessoa"
    },
    {
      "start": 52.715,
      "end": 54.722,
      "text": "menor. Terceira pergunta:"
    },
    {
      "start": 55.362,
      "end": 58.9,
      "text": "eu conseguiria colocar essa decisão diante de Deus sem"
    },
    {
      "start": 58.943,
      "end": 60.43,
      "text": "esconder uma parte dela?"
    },
    {
      "start": 61.449,
      "end": 64.162,
      "text": "Não é uma pergunta para fabricar culpa."
    },
    {
      "start": 64.802,
      "end": 67.276,
      "text": "É uma pergunta para recuperar direção."
    },
    {
      "start": 67.743,
      "end": 70.054,
      "text": "Talvez a resposta seja pedir tempo."
    },
    {
      "start": 70.358,
      "end": 72.951,
      "text": "Talvez seja procurar uma conversa confiável."
    },
    {
      "start": 73.255,
      "end": 76.119,
      "text": "Talvez seja dormir antes de responder."
    },
    {
      "start": 76.597,
      "end": 79.059,
      "text": "Talvez seja sair de uma situação perigosa."
    },
    {
      "start": 79.473,
      "end": 81.707,
      "text": "Talvez seja pedir ajuda profissional."
    },
    {
      "start": 82.185,
      "end": 86.199,
      "text": "Talvez seja simplesmente não chamar de destino aquilo que"
    },
    {
      "start": 86.221,
      "end": 88.001,
      "text": "está tentando comprar sua paz."
    }
  ],
  "scriptures": []
}
