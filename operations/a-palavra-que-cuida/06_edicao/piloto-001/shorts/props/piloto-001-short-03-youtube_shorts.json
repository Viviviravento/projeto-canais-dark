  "cues": [
    {
      "start": 0.12,
      "end": 1.989,
      "text": "Repare em uma coisa importante:"
    },
    {
      "start": 2.651,
      "end": 5.216,
      "text": "Jesus não diz que a vida deixará de ter"
    },
    {
      "start": 5.297,
      "end": 8.421,
      "text": "peso. Ele não diz que, a partir daquele momento,"
    },
    {
      "start": 8.583,
      "end": 10.65,
      "text": "nenhuma responsabilidade existirá,"
    },
    {
      "start": 11.311,
      "end": 12.914,
      "text": "nenhuma dor aparecerá"
    },
    {
      "start": 13.692,
      "end": 17.116,
      "text": "e nenhuma decisão difícil precisará ser tomada."
    },
    {
      "start": 17.383,
      "end": 20.332,
      "text": "O próprio texto fala de um jugo e de"
    },
    {
      "start": 20.379,
      "end": 21.11,
      "text": "um fardo."
    },
    {
      "start": 21.772,
      "end": 23.56,
      "text": "Existe um caminho a aprender."
    },
    {
      "start": 23.873,
      "end": 25.429,
      "text": "Existe uma vida a viver."
    },
    {
      "start": 25.742,
      "end": 29.585,
      "text": "Existe fidelidade, obediência, paciência e verdade."
    },
    {
      "start": 30.352,
      "end": 34.81,
      "text": "Mas há uma diferença enorme entre viver com responsabilidade"
    },
    {
      "start": 35.239,
      "end": 37.84,
      "text": "e viver como se tudo dependesse de você."
    },
    {
      "start": 38.339,
      "end": 40.824,
      "text": "Uma coisa é cuidar daquilo que está em suas"
    },
    {
      "start": 40.94,
      "end": 45.073,
      "text": "mãos. Outra é tentar controlar aquilo que está fora"
    },
    {
      "start": 45.108,
      "end": 48.603,
      "text": "do seu alcance. Uma coisa é amar as pessoas."
    },
    {
      "start": 48.974,
      "end": 52.086,
      "text": "Outra é assumir que você pode salvar cada uma"
    },
    {
      "start": 52.121,
      "end": 55.232,
      "text": "delas. Uma coisa é reconhecer um erro."
    },
    {
      "start": 55.813,
      "end": 59.725,
      "text": "Outra é transformar cada erro numa condenação sem fim."
    }
  ],
  "platform": "youtube_shorts"
}
