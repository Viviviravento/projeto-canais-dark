      "trigger_policy": "show only while the verse text itself is being read"
    },
    {
      "id": "scripture-acf-lucas-10-42",
      "reference": "Lucas 10:42",
      "text": "Mas uma só é necessária; E Maria escolheu a boa parte, a qual não lhe será tirada.",
