      "trigger_policy": "show only while the verse text itself is being read"
    },
    {
      "id": "scripture-acf-lucas-10-41",
      "reference": "Lucas 10:41",
      "text": "E respondendo Jesus, disse-lhe: Marta, Marta, estás ansiosa e afadigada com muitas coisas,",
      "source": "04_assets/video-006/scripture_cards/acf-lucas-10-41.png",
      "block_id": "04-jesus-chama-pelo-nome",
