{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.canais-dark/contracts/v1/ContentBlueprint.schema.json",
  "title": "ContentBlueprint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "blueprint_id", "channel_id", "topic_id", "artifact_kind", "promise", "structure", "performance_notes", "research_refs", "derivative_candidates"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "blueprint_id": {"type": "string", "minLength": 1},
    "channel_id": {"type": "string", "minLength": 1},
    "topic_id": {"type": "string", "minLength": 1},
    "artifact_kind": {"enum": ["script", "beat_sheet", "run_of_show", "capture_plan", "hybrid"]},
    "promise": {"type": "string", "minLength": 1},
    "structure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "purpose", "content"],
        "properties": {
          "id": {"type": "string"},
          "purpose": {"type": "string"},
          "content": {"type": "string"}
        }
      }
    },
    "performance_notes": {"type": "array", "items": {"type": "string"}},
    "research_refs": {"type": "array", "items": {"type": "string"}},
    "derivative_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["source_section", "hook"],
        "properties": {
          "source_section": {"type": "string"},
          "hook": {"type": "string"}
        }
      }
    }
  }
}
