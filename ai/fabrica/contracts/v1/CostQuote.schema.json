{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.canais-dark/contracts/v1/CostQuote.schema.json",
  "title": "CostQuote",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "quote_id", "provider", "model", "operation", "unit", "quantity", "currency", "unit_price", "price_checked_at", "price_source", "expected_cost", "maximum_cost", "status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "quote_id": {"type": "string", "minLength": 1},
    "parent_quote_id": {"type": ["string", "null"]},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "unit": {"type": "string", "minLength": 1},
    "quantity": {"type": "number", "exclusiveMinimum": 0},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "unit_price": {"type": "number", "minimum": 0},
    "price_checked_at": {"type": "string", "format": "date-time"},
    "price_source": {"type": "string", "minLength": 1},
    "expected_cost": {"type": "number", "minimum": 0},
    "maximum_cost": {"type": "number", "minimum": 0},
    "observed_cost": {"type": ["number", "null"], "minimum": 0},
    "status": {"enum": ["quoted", "reserved", "reconciled", "cancelled", "failed"]},
    "metadata": {"type": "object"}
  }
}
