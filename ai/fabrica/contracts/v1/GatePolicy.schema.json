{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.canais-dark/contracts/v1/GatePolicy.schema.json",
  "title": "GatePolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gate_id", "scope", "state", "permanent_human", "evidence", "reason", "promotion", "restoration", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "gate_id": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "state": {"enum": ["full", "sampled", "automatic", "restored"]},
    "permanent_human": {"type": "boolean"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "reason": {"type": "string", "minLength": 1},
    "promotion": {"type": "object", "required": ["clean_runs_to_sampled", "sampled_approvals_to_automatic"], "properties": {"clean_runs_to_sampled": {"type": "integer", "minimum": 1}, "sampled_approvals_to_automatic": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "restoration": {"type": "object", "required": ["critical_defect_immediate", "triggers"], "properties": {"critical_defect_immediate": {"type": "boolean"}, "triggers": {"type": "array", "items": {"type": "string"}, "minItems": 1}}, "additionalProperties": false},
    "counters": {"type": "object", "properties": {"clean_runs": {"type": "integer", "minimum": 0}, "sampled_approvals": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
