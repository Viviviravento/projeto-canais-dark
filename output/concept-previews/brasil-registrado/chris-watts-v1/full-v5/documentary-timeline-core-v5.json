    {
      "id": "CW5-INTERVIEW-ARGUMENT",
      "role": "documentary_dialogue",
      "source": "interview",
      "narrative_focus": "conversa emocional",
      "why_it_matters": "A pergunta registra o que ele disse antes do desfecho judicial.",
      "visual_reason": "A pergunta registra o que ele disse antes do desfecho judicial.",
      "source_audio": "audible",
      "narration_over_dialogue": false,
      "captions": [
        {
          "start": 0.0,
          "end": 4.819999999999993,
          "pt_br": "Repórter: Esta pode ser uma pergunta difícil: vocês discutiram antes?"
        },
        {
          "start": 5.480000000000018,
          "end": 11.639999999999986,
          "pt_br": "Chris Watts: Não foi exatamente uma discussão. Tivemos uma conversa emocional, mas vou deixar por isso mesmo."
        },
        {
          "start": 11.639999999999986,
          "end": 27.900000000000034,
          "pt_br": "Chris Watts: Eu só quero que elas voltem. Se não estiverem seguras, isso está me destruindo. Alguém precisa aparecer e falar."
        },
        {
          "start": 28.560000000000002,
          "end": 29.5,
          "pt_br": "Repórter: A família está em contato com você?"
        }
      ],
      "source_start_seconds": 286.01,
