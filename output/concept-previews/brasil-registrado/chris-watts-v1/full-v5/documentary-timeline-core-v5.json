    {
      "id": "CW5-INTERVIEW-APPEAL",
      "role": "documentary_dialogue",
      "source": "interview",
      "narrative_focus": "apelo público",
      "why_it_matters": "A fala pública deve ser ouvida, não narrada por cima.",
      "visual_reason": "A fala pública deve ser ouvida, não narrada por cima.",
      "source_audio": "audible",
      "narration_over_dialogue": false,
      "captions": [
        {
          "start": 0.0,
          "end": 1.539999999999992,
          "pt_br": "Repórter: Você acha que ela simplesmente foi embora?"
        },
        {
          "start": 2.4200000000000017,
          "end": 10.420000000000002,
          "pt_br": "Chris Watts: Neste momento, eu não quero especular. Espero que ela esteja em algum lugar seguro com as crianças."
        },
        {
          "start": 15.079999999999998,
          "end": 21.159999999999982,
          "pt_br": "Chris Watts: Mas, se alguém está com elas e elas não estão seguras, eu quero que voltem agora. É isso que passa pela minha cabeça."
        },
        {
          "start": 25.260000000000005,
          "end": 39.27999999999999,
          "pt_br": "Chris Watts: Se elas estiverem seguras, vão voltar. Se não estiverem, é essa falta de saber que pesa. Deixei todas as luzes acesas, esperando que as crianças entrassem pela porta. Isso não aconteceu."
        }
      ],
      "source_start_seconds": 124.73,
      "segment_seconds": 39.28,
      "episode_start_seconds": 193.77,
      "episode_end_seconds": 233.066
    },
