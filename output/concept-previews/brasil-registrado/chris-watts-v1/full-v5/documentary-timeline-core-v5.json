    {
      "id": "CW5-NEIGHBOR-TV",
      "role": "documentary_dialogue",
      "source": "neighbor_tv",
      "narrative_focus": "alcance da câmera do vizinho",
      "why_it_matters": "A televisão é a evidência que todos observam; V5 não aplica blur nem delogo.",
      "visual_reason": "A televisão é a evidência que todos observam; V5 não aplica blur nem delogo.",
      "source_audio": "audible",
      "narration_over_dialogue": false,
      "captions": [
        {
          "start": 1.9399999999999977,
          "end": 4.659999999999997,
          "pt_br": "A câmera mostra este carro começando a descer a rua."
        },
        {
          "start": 4.6200000000000045,
          "end": 5.180000000000007,
          "pt_br": "Aquele ali."
        },
        {
          "start": 7.099999999999994,
          "end": 7.9199999999999875,
          "pt_br": "Entende o que eu quero dizer?"
        },
        {
          "start": 7.9199999999999875,
          "end": 9.439999999999998,
          "pt_br": "Ela alcança até lá embaixo."
        },
        {
          "start": 9.580000000000013,
          "end": 10.120000000000005,
          "pt_br": "Legal."
        },
        {
          "start": 10.360000000000014,
          "end": 11.460000000000008,
          "pt_br": "Ele mora ali ao lado."
        },
        {
          "start": 12.52000000000001,
          "end": 13.080000000000013,
          "pt_br": "Podemos ir?"
        },
        {
          "start": 14.560000000000002,
          "end": 15.900000000000006,
          "pt_br": "Eu estava falando dessa pressão."
        },
        {
          "start": 17.439999999999998,
          "end": 18.560000000000002,
          "pt_br": "Vai ficar perto de quatro."
        },
        {
          "start": 18.659999999999997,
          "end": 20.819999999999993,
          "pt_br": "Sim, ela pega carros vindo por aqui."
        },
        {
          "start": 20.74000000000001,
          "end": 23.120000000000005,
          "pt_br": "Eu registro o que vem por aqui quando faz a curva."
        },
        {
          "start": 24.19999999999999,
          "end": 27.539999999999992,
          "pt_br": "À noite, geralmente eu percebo o carro fazendo a curva."
        },
        {
          "start": 28.180000000000007,
          "end": 29.97999999999999,
          "pt_br": "Então, a menos que ela pare bem aqui,"
        },
        {
          "start": 29.97999999999999,
          "end": 33.19999999999999,
          "pt_br": "eu teria visto se ela tivesse saído a pé."
        },
        {
          "start": 39.31999999999999,
          "end": 40.19999999999999,
          "pt_br": "Diesel."
        }
      ],
      "source_start_seconds": 180.0,
      "segment_seconds": 40.25,
