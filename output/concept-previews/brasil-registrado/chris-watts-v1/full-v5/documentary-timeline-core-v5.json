    {
      "id": "CW5-INTERVIEW-TIMELINE",
      "role": "documentary_dialogue",
      "source": "interview",
      "narrative_focus": "versão inicial e Nicole",
      "why_it_matters": "A entrevista fixa a linha do tempo pública que seria comparada a outros registros.",
      "visual_reason": "A entrevista fixa a linha do tempo pública que seria comparada a outros registros.",
      "source_audio": "audible",
      "narration_over_dialogue": false,
      "captions": [
        {
          "start": 0.0,
          "end": 3.900000000000002,
          "pt_br": "Repórter: O que aconteceu? Conte o que aconteceu."
        },
        {
          "start": 4.279999999999998,
          "end": 10.540000000000003,
          "pt_br": "Chris Watts: Ela voltou do aeroporto às duas da manhã. Eu saí por volta de 5h15; ela ainda estava aqui."
        },
        {
          "start": 12.3,
          "end": 16.540000000000003,
          "pt_br": "Chris Watts: Por volta de 12h10, a amiga Nicole chegou à porta."
        },
        {
          "start": 17.06,
          "end": 24.179999999999996,
          "pt_br": "Chris Watts: Mandei mensagens e liguei algumas vezes. Ela não respondeu; também não respondia às outras pessoas."
        },
        {
          "start": 24.84,
          "end": 33.25999999999999,
          "pt_br": "Chris Watts: Foi isso que preocupou muita gente. Se ela não responde a mim, pode estar ocupada; mas não responder a ninguém era preocupante."
        },
        {
          "start": 33.66,
          "end": 46.44,
          "pt_br": "Chris Watts: Nicole ligou quando estava na porta. Voltei para casa. Ela não estava aqui. As crianças também não. Não havia ninguém."
        }
      ],
      "source_start_seconds": 30.98,
      "segment_seconds": 46.44,
      "episode_start_seconds": 48.688,
