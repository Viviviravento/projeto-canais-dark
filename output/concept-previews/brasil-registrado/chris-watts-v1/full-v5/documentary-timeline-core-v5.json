      "captions": [
        {
          "start": 0.0,
          "end": 8.879999999999995,
          "pt_br": "Repórter: O que a polícia, o xerife ou os vizinhos estão dizendo?"
        },
        {
          "start": 9.479999999999961,
          "end": 38.77999999999997,
          "pt_br": "Chris Watts: Eles trabalham com cães farejadores. Ontem, a polícia fez buscas na casa e reuniu informações. Há muita atividade ao redor, e espero que isso leve a algo positivo."
        },
        {
          "start": 39.41999999999996,
          "end": 43.539999999999964,
          "pt_br": "Repórter: Os vizinhos viram alguma coisa?"
        },
        {
          "start": 43.839999999999975,
          "end": 51.02999999999997,
          "pt_br": "Chris Watts: A polícia foi de porta em porta perguntando sobre câmeras e tudo mais. Até agora, nada."
        }
